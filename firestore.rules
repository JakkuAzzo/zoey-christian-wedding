rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOrganiser() {
      return request.auth != null && request.auth.uid == '8eUvB9M8YVSNdtOQAbTYucJB4yH3';
    }
    function validRsvp(data) {
      return data.keys().hasAll(['attendance', 'names', 'count', 'children', 'dietary', 'access', 'submittedAt'])
        && data.keys().hasOnly(['attendance', 'names', 'count', 'children', 'dietary', 'access', 'submittedAt'])
        && data.attendance in ['yes', 'no']
        && data.names is string && data.names.size() > 0 && data.names.size() <= 500
        && data.count is int
        && ((data.attendance == 'yes' && data.count >= 1 && data.count <= 30) || (data.attendance == 'no' && data.count == 0))
        && data.children is string && data.children.size() <= 1000
        && data.dietary is string && data.dietary.size() <= 1000
        && data.access is string && data.access.size() <= 1000;
    }
    match /invitations/{code} {
      allow read, delete: if isOrganiser();
      allow create: if isOrganiser() && code.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['label', 'createdAt'])
        && request.resource.data.keys().hasAll(['label', 'createdAt'])
        && request.resource.data.label is string && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 160
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }
    match /seating/{id} {
      allow read, delete: if isOrganiser();
      allow create, update: if isOrganiser()
        && exists(/databases/$(database)/documents/rsvps/$(id))
        && request.resource.data.keys().hasOnly(['table'])
        && request.resource.data.keys().hasAll(['table'])
        && request.resource.data.table is string && request.resource.data.table.size() <= 100;
    }
    // A guest session is created only after a valid invitation code is supplied.
    match /guest_sessions/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, update, delete: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.keys().hasAll(['code'])
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[a-f0-9]{32}$')
        && exists(/databases/$(database)/documents/invitations/$(request.resource.data.code));
    }
    // Messages are visible only to guests with a valid invitation session.
    match /messages/{id} {
      allow read: if isOrganiser() || (request.auth != null
        && exists(/databases/$(database)/documents/guest_sessions/$(request.auth.uid))
        && exists(/databases/$(database)/documents/invitations/$(get(/databases/$(database)/documents/guest_sessions/$(request.auth.uid)).data.code)));
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'message', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/message_proofs/$(id))
        && existsAfter(/databases/$(database)/documents/message_proofs/$(id));
      allow update, delete: if false;
    }
    // New messages are explicitly public. Existing invitation-only messages remain private.
    match /public_messages/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'verified', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'message', 'verified', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 500
        && request.resource.data.verified is bool
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.verified || (
          !exists(/databases/$(database)/documents/public_message_proofs/$(id))
          && existsAfter(/databases/$(database)/documents/public_message_proofs/$(id))
          && exists(/databases/$(database)/documents/invitations/$(getAfter(/databases/$(database)/documents/public_message_proofs/$(id)).data.code))));
      allow update, delete: if false;
    }
    match /public_message_proofs/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.keys().hasAll(['code'])
        && request.resource.data.code is string && request.resource.data.code.matches('^[a-f0-9]{32}$')
        && exists(/databases/$(database)/documents/invitations/$(request.resource.data.code))
        && !exists(/databases/$(database)/documents/public_messages/$(id))
        && existsAfter(/databases/$(database)/documents/public_messages/$(id))
        && getAfter(/databases/$(database)/documents/public_messages/$(id)).data.verified == true;
    }
    match /message_proofs/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.keys().hasAll(['code'])
        && request.resource.data.code is string && request.resource.data.code.matches('^[a-f0-9]{32}$')
        && exists(/databases/$(database)/documents/invitations/$(request.resource.data.code))
        && !exists(/databases/$(database)/documents/message_uses/$(request.resource.data.code))
        && existsAfter(/databases/$(database)/documents/messages/$(id))
        && getAfter(/databases/$(database)/documents/message_uses/$(request.resource.data.code)).data.messageId == id;
    }
    match /message_uses/{code} {
      allow read, update, delete: if false;
      allow create: if code.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['messageId'])
        && request.resource.data.keys().hasAll(['messageId'])
        && request.resource.data.messageId is string
        && getAfter(/databases/$(database)/documents/message_proofs/$(request.resource.data.messageId)).data.code == code
        && existsAfter(/databases/$(database)/documents/messages/$(request.resource.data.messageId));
    }
    match /rsvps/{code} {
      allow read, delete: if isOrganiser();
      allow update: if isOrganiser() && validRsvp(request.resource.data)
        && request.resource.data.submittedAt == resource.data.submittedAt;
      allow create: if validRsvp(request.resource.data)
        && request.resource.data.submittedAt == request.time
        && (isOrganiser() || (code.matches('^[a-f0-9]{32}$')
          && exists(/databases/$(database)/documents/invitations/$(code))));
    }
    // Gifts are entered manually by an organiser; no payment information is stored.
    match /gifts/{id} {
      allow read, delete: if isOrganiser();
      allow create: if isOrganiser()
        && request.resource.data.keys().hasOnly(['giver', 'description', 'createdAt'])
        && request.resource.data.keys().hasAll(['giver', 'description', 'createdAt'])
        && request.resource.data.giver is string && request.resource.data.giver.size() > 0 && request.resource.data.giver.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }
  }
}
